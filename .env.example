# ── DATABASE ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/trendmarga

# ── CLERK (admin/staff auth) ───────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/cms/dashboard

# ── API ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4001

# ── GOOGLE MAPS (Delivery module – Phase 1 optional) ───
GOOGLE_MAPS_API_KEY=

# ── REDIS (Phase 2) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NODE ───────────────────────────────────────────────
NODE_ENV=development

# ── FEATURE FLAGS ──────────────────────────────────────
# All features default to OFF. Set to "true" to enable.
# Server-side flags (API + Next.js server):
FEATURE_CMS_CONTENT=false
FEATURE_SEARCH=false
FEATURE_INVENTORY=false
FEATURE_NOTIFICATIONS=false
FEATURE_REVIEWS=false
FEATURE_DISCOUNTS=false
FEATURE_PWA=false

# Client-side flags (browser bundle — must mirror server flags):
NEXT_PUBLIC_FEATURE_CMS_CONTENT=false
NEXT_PUBLIC_FEATURE_SEARCH=false
NEXT_PUBLIC_FEATURE_INVENTORY=false
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_REVIEWS=false
NEXT_PUBLIC_FEATURE_DISCOUNTS=false
NEXT_PUBLIC_FEATURE_PWA=false

# ── NOTIFICATIONS (when FEATURE_NOTIFICATIONS=true) ────
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=TrendMarga
RESEND_API_KEY=
EMAIL_FROM=orders@trendmarga.com
