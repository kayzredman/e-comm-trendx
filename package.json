{
  "name": "trendmarga",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:safe": "bash scripts/dev-supervisor.sh",
    "dev:kill": "pkill -9 -f 'trendx/apps.*(nodemon|next dev|tsx watch|nest start|dev-supervisor)' 2>/dev/null; lsof -i :4001 -i :4002 -sTCP:LISTEN -t 2>/dev/null | xargs -r kill -9 2>/dev/null; echo done",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@trendmarga/db",
    "db:migrate": "turbo run db:migrate --filter=@trendmarga/db",
    "db:studio": "turbo run db:studio --filter=@trendmarga/db",
    "migrate:dev": "bash scripts/migrate-railway.sh dev",
    "migrate:staging": "bash scripts/migrate-railway.sh staging",
    "migrate:prod": "bash scripts/migrate-railway.sh production"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.2",
    "eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20"
  }
}
