# PostgreSQL — Railway provides this automatically in Railway environments
DATABASE_URL=postgresql://user:password@host:port/dbname

# Clerk — must match apps/web Clerk app
CLERK_SECRET_KEY=sk_test_

# Clerk webhook secret — create in Clerk dashboard under Webhooks
# Endpoint: https://your-api-url.railway.app/users/webhook
CLERK_WEBHOOK_SECRET=whsec_

# Server port
PORT=4001

# Node environment
NODE_ENV=development
